    "version": "0.2.0",
    "configurations": [
        {
            "name": "gqlite c++ (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:CC_PKG_ROOT}/host-build-debug/gqlite/gqlite_cpp_tests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "showDisplayString": true
        },
        {
            "name": "gqlite cmd (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${env:CC_PKG_ROOT}/host-build-debug/gqlite/gqlite",
            "args": [],
            "stopAtEntry": false,
            "cwd": "/tmp",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "showDisplayString": true
        },
        {
            "name": "gqlite tck (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/ruby",
            "args": [
                "${env:CC_PKG_ROOT}/src/gqlite/tests/rb/gqlite-tck.rb",
                "--abort-on-first-error"
            ],
            "stopAtEntry": false,
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/rb",
            "environment": [
                {
                    "name": "RUST_BACKTRACE",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "showDisplayString": true
        },
        {
            "name": "gqlite rspec (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/ruby",
            "args": [
                "/usr/bin/rspec",
                "${env:CC_PKG_ROOT}/src/gqlite/tests/rb/gqlite-rspec.rb"
            ],
            "stopAtEntry": false,
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/rb",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "showDisplayString": true
        },
        {
            "name": "gqlite benchmark (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/ruby",
            "args": [
                "${env:CC_PKG_ROOT}/src/gqlite/tests/rb/gqlite-bench.rb"
            ],
            "stopAtEntry": false,
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/rb",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "showDisplayString": true
        }
    ]
}