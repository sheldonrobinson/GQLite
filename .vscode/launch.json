{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "gqlite c++ (gdb)",
            "type": "lldb",
            "request": "launch",
            "program": "${env:CC_PKG_ROOT}/host-build-debug/gqlite/gqlite_cpp_tests",
            "args": [],
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/",
        },
        {
            "name": "gqlite cmd (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${env:CC_PKG_ROOT}/host-build-debug/gqlite/gqlite",
            "args": [],
            "cwd": "/tmp",
            "env": {
                "RUST_BACKTRACE": "1"
            },
        },
        {
            "name": "gqlite tck (gdb)",
            "type": "lldb",
            "request": "launch",
            "program": "/usr/bin/ruby",
            "args": [
                "${env:CC_PKG_ROOT}/src/gqlite/tests/rb/gqlite-tck.rb",
                "--abort-on-first-error"
            ],
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/rb",
            "env": {
                "RUST_BACKTRACE": "1"
            },
        },
        {
            "name": "gqlite rspec (gdb)",
            "type": "lldb",
            "request": "launch",
            "program": "/usr/bin/ruby",
            "args": [
                "/usr/bin/rspec",
                "${env:CC_PKG_ROOT}/src/gqlite/tests/rb/gqlite-rspec.rb"
            ],
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/rb",
        },
        {
            "name": "gqlite benchmark (gdb)",
            "type": "lldb",
            "request": "launch",
            "program": "/usr/bin/ruby",
            "args": [
                "${env:CC_PKG_ROOT}/src/gqlite/tests/rb/gqlite-bench.rb"
            ],
            "cwd": "${env:CC_PKG_ROOT}/src/gqlite/tests/rb",
        }
    ]
}