WHITESPACE = _{ " " | "\t" }
ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* ~ "'"* }
char = {
    !("'" | "\\") ~ ANY
    | "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t")
    | "\\" ~ ("u" ~ ASCII_HEX_DIGIT{4})
}

// Query
query = _{ SOI ~ statement* ~ ";"? ~ EOI }

// fragments

labels = { (":" ~ ident)* }
pattern = { ident? ~ labels ~ map? }
node_pattern = { "(" ~ pattern ~ ")" }
edge_pattern = { "(" ~ pattern ~ ")-[" ~ pattern ~ "]->(" ~ pattern ~ ")" }
node_or_edge_pattern = _{ edge_pattern | node_pattern }

// Statements
statement = { create_statement | match_statement | return_statement }

create_statement = { "CREATE" ~ node_or_edge_pattern ~ ( "," ~ node_or_edge_pattern )* }
match_statement = { "MATCH" ~ node_or_edge_pattern ~ ( "," ~ node_or_edge_pattern )* }
return_statement = { "RETURN" ~ named_expression+ }

// literals
int = { ("+" | "-")? ~ ASCII_DIGIT+ }
num = @{ int ~ ("." ~ ASCII_DIGIT*)? ~ (^"e" ~ int)? }
string_literal = ${ "'" ~ inner ~ "'" }
inner = @{ char* }
// Expression

named_expression = { expression | ident ~ expression }
expression = _{ ident | map | string_literal | num}

pair = { ident ~ ":" ~ expression }

map = {
  "{" ~ "}" |
  "{" ~ pair ~ ("," ~ pair)* ~ "}"
}