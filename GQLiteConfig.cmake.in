# - Config file for the GQLite package
# It defines the following variables
#  GQLITE_INCLUDE_DIRS - include directories for gqlite
#  GQLITE_LIBRARIES    - libraries to link against
 
@PACKAGE_INIT@

# Compute paths
get_filename_component(GQLITE_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
set(GQLITE_INCLUDE_DIRS "@PACKAGE_INSTALL_INCLUDE_DIR@")

# Our library dependencies (contains definitions for IMPORTED targets)
if(NOT TARGET gqlite AND NOT GQLITE_BINARY_DIR)
  include("${GQLITE_CMAKE_DIR}/GQLiteTargets.cmake")
endif()

add_library(GQLite INTERFACE IMPORTED)
set_target_properties(GQLite PROPERTIES
  INTERFACE_INCLUDE_DIRECTORIES "${GQLITE_INCLUDE_DIRS}"
  INTERFACE_LINK_LIBRARIES "gqlite"
) 
